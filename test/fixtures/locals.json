  ],
  "TestExecutePanicDuringCall": [
    {
      "data": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{doPanic}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "direct func call panics"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:2: executing \"t\" at <doPanic>: error calling doPanic: custom panic string"
      }
    },
    {
      "data": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call doPanic}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "indirect func call panics"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:7: executing \"t\" at <doPanic>: error calling doPanic: custom panic string"
      }
    },
    {
      "data": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{.GetU}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "direct method call panics"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:2: executing \"t\" at <.GetU>: error calling GetU: runtime error: invalid memory address or nil pointer dereference"
      }
    },
    {
      "data": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .GetU}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "indirect method call panics"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:7: executing \"t\" at <.GetU>: error calling GetU: runtime error: invalid memory address or nil pointer dereference"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .PanicFunc}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "func field call panics"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:2: executing \"t\" at <call .PanicFunc>: error calling call: test panic"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{.NonEmptyInterfaceNil.Method0}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "method call on nil interface"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "template: t:1:23: executing \"t\" at <.NonEmptyInterfaceNil.Method0>: nil pointer evaluating template.I.Method0"
      }
    }
  ],
  "TestFunctionCheckDuringCall": [
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call nothing"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "wrong number of args for call: want at least 1 got 0"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .True}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call non-function"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: non-function .True of type bool"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .BinaryFunc 1}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call func with wrong argument"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: wrong number of args for .BinaryFunc: got 1 want 2"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .VariadicFuncInt}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call variadic func with wrong argument"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: wrong number of args for .VariadicFuncInt: got 0 want at least 1"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .TooFewReturnCountFunc}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call too few return number func"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: function .TooFewReturnCountFunc has 0 return values; should be 1 or 2"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .TooManyReturnCountFunc}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call too many return number func"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: function .TooManyReturnCountFunc has 3 return values; should be 1 or 2"
      }
    },
    {
      "data": {
        "$fixture": "73b8caf79e3fcbc3"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call .InvalidReturnTypeFunc}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call invalid return type func"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: invalid function signature for .InvalidReturnTypeFunc: second return value should be error; is bool"
      }
    },
    {
      "data": {
        "$fixture": "45a9bb967d67ddf1"
      },
      "input": {
        "kind": "string",
        "type": "string",
        "value": "{{call (len \"test\")}}"
      },
      "name": {
        "kind": "string",
        "type": "string",
        "value": "call pipeline"
      },
      "wantErr": {
        "kind": "string",
        "type": "string",
        "value": "error calling call: non-function len \"test\" of type int"
      }
    }
  ],
  "TestInterfaceValues": [
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "ERROR: index of untyped nil"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{index .Nil 1}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "2"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{index .Slice 2}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "2"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{index .Slice .Two}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "ERROR: call of nil"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{call .Nil 1}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "2"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{call .PlusOne 1}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "2"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{call .PlusOne .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "0"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{and (index .Slice 0) true}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "0"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{and .Zero true}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{and (index .Slice 1) false}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{and .One false}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{or (index .Slice 0) false}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{or .Zero false}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "1"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{or (index .Slice 1) true}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "1"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{or .One true}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{not (index .Slice 0)}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{not .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{not (index .Slice 1)}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{not .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{eq (index .Slice 0) .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{eq (index .Slice 1) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{ne (index .Slice 0) .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{ne (index .Slice 1) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{ge (index .Slice 0) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{ge (index .Slice 1) .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{gt (index .Slice 0) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{gt (index .Slice 1) .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{le (index .Slice 0) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{le (index .Slice 1) .Zero}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "true"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{lt (index .Slice 0) .One}}"
      }
    },
    {
      "out": {
        "kind": "string",
        "type": "string",
        "value": "false"
      },
      "text": {
        "kind": "string",
        "type": "string",
        "value": "{{lt (index .Slice 1) .Zero}}"
      }
    }
  ],
