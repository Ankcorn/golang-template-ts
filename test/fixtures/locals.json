        "type": "string",
        "value": "MissingKeyOnMapPtrToNil"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.MissingKey}}"
      },
      "value": {
        "$fixture": "6d00055a485c8a0b"
      },
      "want": {
        "kind": "string",
        "type": "string",
        "value": "<nil>"
      }
