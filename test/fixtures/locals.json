        "type": "string",
        "value": "MissingFieldOnNil"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.MissingField}}"
      },
      "value": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "want": {
        "kind": "string",
        "type": "string",
        "value": "can't evaluate field MissingField in type *template.T"
      }
    },
    {
      "name": {
        "kind": "string",
        "type": "string",
        "value": "MissingFieldOnNonNil"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.MissingField}}"
      },
      "value": {
        "$fixture": "7be3f1203cffb1d3"
      },
      "want": {
        "kind": "string",
        "type": "string",
        "value": "can't evaluate field MissingField in type *template.T"
      }
    },
    {
      "name": {
        "kind": "string",
        "type": "string",
        "value": "ExistingFieldOnNil"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.X}}"
      },
      "value": {
        "$fixture": "2fc4440b9108e1a3"
      },
      "want": {
        "kind": "string",
        "type": "string",
        "value": "nil pointer evaluating *template.T.X"
      }
    },
    {
      "name": {
        "kind": "string",
        "type": "string",
        "value": "MissingKeyOnNilMap"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.MissingKey}}"
      },
      "value": {
        "$fixture": "d005cc6373992ad1"
      },
      "want": {
        "kind": "string",
        "type": "string",
        "value": "nil pointer evaluating *map[string]string.MissingKey"
      }
    },
    {
      "name": {
        "kind": "string",
        "type": "string",
        "value": "MissingKeyOnNilMapPtr"
      },
      "src": {
        "kind": "string",
        "type": "string",
        "value": "{{.MissingKey}}"
      },
      "value": {
